{
  "$schema": "https://glama.ai",
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server@latest"
      ],
      "env": {
        "SUPABASE_URL": "http://127.0.0.1:54321",
        "SUPABASE_ANON_KEY": "YOUR_LOCAL_ANON_KEY_PLACEHOLDER",
        "SUPABASE_SERVICE_ROLE_KEY": "YOUR_LOCAL_SERVICE_ROLE_KEY_PLACEHOLDER"
      },
      "settings": {
        "dataTypesRule": "frios-pezca-data-types",
        "enforceGrams": true,
        "preventFloatingPoint": true
      }
    },
    "docscout": {
      "command": "npx",
      "args": [
        "-y",
        "docscout-mcp@latest"
      ],
      "env": {
        "DOCSCOUT_CACHE_DIR": "./.system_generated/docscout_cache"
      },
      "settings": {
        "indexedDocs": [
          "https://nextjs.org",
          "https://supabase.com",
          "https://tailwindcss.com"
        ],
        "refreshIntervalMs": 86400000
      }
    },
    "ricoui-stitch": {
      "command": "node",
      "args": [
        "./.agents/skills/stitch-sync-mcp.js"
      ],
      "env": {
        "DESIGN_TOKENS_PATH": "./stitch.json",
        "DESIGN_SYSTEM_MD": "./DESIGN.md"
      }
    }
  }
}
