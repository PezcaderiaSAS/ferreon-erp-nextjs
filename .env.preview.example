# ==============================================================================
# Alquileres System — Plantilla de Entorno PREVIEW (Vercel Scope: Preview)
# Configurar estas variables EXCLUSIVAMENTE en Vercel -> Scope: Preview.
# Garantiza aislamiento total frente a Producción y bloqueo estricto de indexación.
# ==============================================================================

# Entorno y Bloqueo de Indexación / Redirección
NODE_ENV=production
# En Vercel, VERCEL_ENV=preview es inyectado automáticamente por la plataforma
VERCEL_ENV=preview
NEXT_PUBLIC_APP_URL=https://tu-proyecto-git-preview.vercel.app
# DEJAR VACÍO en Preview para no activar redirecciones 301 hacia Producción
CANONICAL_APP_HOST=
# DEBE permanecer en 'false' en Preview (robots.txt Disallow: / + X-Robots-Tag: noindex, nofollow)
ALLOW_INDEXING=false
LEGACY_VERCEL_HOSTS=alquileres-erp-nextjs-ruby.vercel.app

# Referencia pública opcional del proyecto PROD para diagnósticos anti-cruce en Preview
PRODUCTION_SUPABASE_REF=ref-proyecto-produccion-placeholder

# Supabase Preview (Proyecto Supabase $0 INDEPENDIENTE de Producción)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-preview.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar_con_anon_key_preview_placeholder
SUPABASE_SERVICE_ROLE_KEY=reemplazar_con_service_role_key_preview_placeholder

# Conexión PostgreSQL Preview (Base de datos aislada con seed_clean.sql)
# Puerto 6543 (PgBouncer Transaction Pooler) para Vercel Serverless
DATABASE_URL="postgresql://postgres.[REF_PREVIEW]:[PASSWORD_PREVIEW]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Puerto 5432 (Session Direct) para migraciones en el proyecto Preview
DIRECT_URL="postgresql://postgres.[REF_PREVIEW]:[PASSWORD_PREVIEW]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis Preview (Instancia Redis independiente de Producción)
UPSTASH_REDIS_REST_URL=https://tu-endpoint-preview.upstash.io
UPSTASH_REDIS_REST_TOKEN=reemplazar_con_token_redis_preview_placeholder

# Stripe Test (Sandbox en Preview, nunca llaves sk_live_)
STRIPE_SECRET_KEY=sk_test_reemplazar_en_vercel_preview
STRIPE_WEBHOOK_SECRET=whsec_test_reemplazar_en_vercel_preview
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_test_mensual_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ID_LIFETIME=price_test_vitalicio_placeholder

# Token Secreto de Cron Preview (opcional)
CRON_SECRET=reemplazar_con_secreto_cron_preview
