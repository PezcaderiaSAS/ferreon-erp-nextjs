// ============================================================================
// FERREON ERP & WMS - ESQUEMA DE DATOS MULTI-TENANT CON PRISMA ORM
// Arquitectura: Shared Database, Shared Schema (Aislamiento por Fila / tenantId)
// Base de Datos: PostgreSQL (Supabase)
// ============================================================================

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// 1. ENUMERACIONES DEL SISTEMA (Type Safety Estricto)
// ----------------------------------------------------------------------------

enum TenantStatus {
  trialing
  active
  past_due
  canceled
  unpaid

  @@map("tenant_status")
}

enum UserRole {
  ULTRAADMIN
  SUPERADMIN
  ADMIN
  OPERADOR_BODEGA
  FACTURACION_CARTERA
  CONSULTOR_AUDITOR
  VENDEDOR

  @@map("user_role")
}

enum DocumentType {
  NIT
  CC
  CE
  PP

  @@map("document_type")
}

enum EquipmentStatus {
  DISPONIBLE
  ALQUILADO
  MANTENIMIENTO
  BAJA

  @@map("equipment_status")
}

enum RentalStatus {
  BORRADOR
  COTIZACION
  PENDIENTE_ENTREGA
  ACTIVO_EN_OBRA
  FINALIZADO
  CANCELADO

  @@map("rental_status")
}

enum MovementType {
  ENTRADA_COMPRA
  SALIDA_ALQUILER
  RETORNO_ALQUILER
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  TRANSFERENCIA_ENTRADA
  TRANSFERENCIA_SALIDA
  MANTENIMIENTO

  @@map("movement_type")
}

// ----------------------------------------------------------------------------
// 2. NÚCLEO SAAS & MULTI-TENANCY (EMPRESAS Y MIEMBROS)
// ----------------------------------------------------------------------------

model Tenant {
  id                   String       @id @default(uuid()) @db.Uuid
  nombre               String       @db.VarChar(255)
  nit                  String?      @db.VarChar(50)
  slug                 String       @unique @db.VarChar(100)
  telefono             String?      @db.VarChar(50)
  ciudad               String?      @db.VarChar(100)
  tamanoEmpresa        String?      @map("tamano_empresa") @db.VarChar(50)
  autorizado           Boolean      @default(false)
  stripeCustomerId     String?      @unique @map("stripe_customer_id") @db.VarChar(100)
  stripeSubscriptionId String?      @map("stripe_subscription_id") @db.VarChar(100)
  subscriptionStatus   TenantStatus @default(trialing) @map("subscription_status")
  planId               String       @default("plan_monthly_flat") @map("plan_id") @db.VarChar(50)
  trialEndsAt          DateTime     @map("trial_ends_at") @db.Timestamptz(6)
  configuracion        Json?        @default("{}")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?    @map("deleted_at") @db.Timestamptz(6)

  // Relaciones Multi-Tenant con entidades del ERP
  users              User[]
  customers          Customer[]
  equipments         Equipment[]
  rentalContracts    RentalContract[]
  rentalDetails      RentalDetail[]
  inventoryMovements InventoryMovement[]
  auditLogs          AuditLog[]
  cashSessions       CashSession[]
  cashMovements      CashMovement[]
  zonasFlete         ZonaFleteBucaramanga[]
  rutasDespacho      RutaDespacho[]
  paradasRuta        RutaParada[]

  @@index([slug])
  @@map("empresas")
}

model User {
  id              BigInt   @id @default(autoincrement())
  empresaId       String   @map("empresa_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid // Referencia a auth.users de Supabase
  rol             UserRole @default(OPERADOR_BODEGA)
  esEmpresaActiva Boolean  @default(true) @map("es_empresa_activa")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, userId])
  @@index([empresaId])
  @@index([userId])
  @@map("empresa_usuarios")
}

// ----------------------------------------------------------------------------
// 3. MÓDULO ERP: CLIENTES Y CARTERA
// ----------------------------------------------------------------------------

model Customer {
  id              Int          @id @default(autoincrement())
  empresaId       String       @map("empresa_id") @db.Uuid
  tipoDocumento   DocumentType @default(NIT) @map("tipo_documento")
  numeroDocumento String       @map("numero_documento") @db.VarChar(50)
  nombre          String       @db.VarChar(255)
  email           String?      @db.VarChar(255)
  telefono        String?      @db.VarChar(50)
  direccion       String?
  ciudad          String?      @default("Bucaramanga")
  estadoCartera   String?      @default("AL_DIA") @map("estado_cartera")
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime?    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime?    @map("deleted_at") @db.Timestamptz(6)

  tenant          Tenant           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  rentalContracts RentalContract[]

  // Evita duplicidad de NIT/Cédula dentro de la misma empresa
  @@unique([numeroDocumento, empresaId])
  @@index([empresaId])
  @@index([numeroDocumento])
  @@map("clientes")
}

// ----------------------------------------------------------------------------
// 4. MÓDULO WMS: INFRAESTRUCTURA DE BODEGAS Y ALMACENAMIENTO
// ----------------------------------------------------------------------------

// ----------------------------------------------------------------------------
// 4. MÓDULO ERP: MAQUINARIA, EQUIPOS E INVENTARIO
// ----------------------------------------------------------------------------

model Equipment {
  id        BigInt          @id @default(autoincrement())
  empresaId String          @map("empresa_id") @db.Uuid
  codigo    String          @db.VarChar(50)
  nombre    String          @db.VarChar(255)
  categoria String          @db.VarChar(100)
  estado    EquipmentStatus @default(DISPONIBLE)

  // Stock estricto en unidades enteras (Cero coma flotante)
  stockTotal      Int @default(0) @map("stock_total")
  stockDisponible Int @default(0) @map("stock_disponible")

  tarifaDia       Decimal   @default(0) @map("tarifa_dia") @db.Decimal(12, 2)
  tarifaSemana    Decimal?  @default(0) @map("tarifa_semana") @db.Decimal(12, 2)
  tarifaMes       Decimal?  @default(0) @map("tarifa_mes") @db.Decimal(12, 2)
  valorReposicion Decimal?  @default(0) @map("valor_reposicion") @db.Decimal(12, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  rentalDetails      RentalDetail[]
  inventoryMovements InventoryMovement[]

  @@unique([codigo, empresaId])
  @@index([empresaId])
  @@index([codigo])
  @@map("equipos")
}

// ----------------------------------------------------------------------------
// 6. TRANSACCIONALIDAD: CONTRATOS DE ALQUILER Y DETALLES
// ----------------------------------------------------------------------------

model RentalContract {
  id                 Int          @id @default(autoincrement())
  empresaId          String       @map("empresa_id") @db.Uuid
  consecutivo        Int
  clienteId          Int          @map("cliente_id")
  cotizacionOrigenId String?      @map("cotizacion_origen_id")
  estado             RentalStatus @default(BORRADOR)

  subtotalEquipos    Decimal   @default(0) @map("subtotal_equipos") @db.Decimal(12, 2)
  total              Decimal   @default(0) @db.Decimal(12, 2)
  totalPresupuestado Decimal?  @map("total_presupuestado") @db.Decimal(14, 2)
  totalLiquidado     Decimal?  @map("total_liquidado") @db.Decimal(14, 2)
  totalPagado        Decimal   @default(0) @map("total_pagado") @db.Decimal(12, 2)
  saldoPendiente     Decimal   @default(0) @map("saldo_pendiente") @db.Decimal(12, 2)
  deposito           Decimal   @default(0) @db.Decimal(12, 2)
  depositoGarantia   Decimal?  @default(0) @map("deposito_garantia") @db.Decimal(14, 2)
  depositoAplicado   Decimal?  @default(0) @map("deposito_aplicado") @db.Decimal(14, 2)
  aplicaIva          Boolean?  @default(false) @map("aplica_iva")
  valorIva           Decimal?  @default(0) @map("valor_iva") @db.Decimal(12, 2)
  creadoPor          String?   @map("creado_por")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime? @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant             Tenant              @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  customer           Customer            @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  details            RentalDetail[]
  inventoryMovements InventoryMovement[]

  @@unique([consecutivo, empresaId])
  @@index([empresaId])
  @@index([clienteId])
  @@map("alquileres")
}

model RentalDetail {
  id         Int     @id @default(autoincrement())
  empresaId  String  @map("empresa_id") @db.Uuid
  alquilerId Int     @map("alquiler_id")
  equipoId   BigInt  @map("equipo_id")

  // Control de segmentación por línea independiente
  lineaNumero           Int       @default(1) @map("linea_numero")
  cantidad              Int       // Cantidad en unidades enteras
  cantidadDevuelta      Int       @default(0) @map("cantidad_devuelta")
  diasContratados       Int       @map("dias_contratados")
  fechaInicio           DateTime  @map("fecha_inicio") @db.Date
  fechaFin              DateTime? @map("fecha_fin") @db.Date

  // Tarifas persistentes y control de edición manual
  tarifaAplicada        Decimal   @map("tarifa_aplicada") @db.Decimal(12, 2)
  tarifaPersonalizada   Boolean   @default(false) @map("tarifa_personalizada")
  subtotalLinea         Decimal   @map("subtotal_linea") @db.Decimal(12, 2)
  subtotalPersonalizado Boolean   @default(false) @map("subtotal_personalizado")
  devuelto              Boolean   @default(false)
  costoDano             Decimal   @default(0) @map("costo_dano") @db.Decimal(12, 2)

  // Subcontratación / Re-Renting
  esSubcontratado          Boolean?  @default(false) @map("es_subcontratado")
  proveedorSubcontratadoId String?   @map("proveedor_subcontratado_id") @db.Uuid
  costoDiarioProveedor     Decimal?  @default(0) @map("costo_diario_proveedor") @db.Decimal(12, 2)

  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  rental    RentalContract @relation(fields: [alquilerId], references: [id], onDelete: Cascade)
  equipment Equipment      @relation(fields: [equipoId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([alquilerId, lineaNumero])
  @@index([equipoId, fechaInicio, fechaFin])
  @@map("alquiler_detalles")
}

// ----------------------------------------------------------------------------
// 7. TRAZABILIDAD WMS: KARDEX INMUTABLE DE MOVIMIENTOS
// ----------------------------------------------------------------------------

model InventoryMovement {
  id             String       @id @default(uuid()) @db.Uuid
  empresaId      String       @map("empresa_id") @db.Uuid
  equipoId       BigInt       @map("equipo_id")
  alquilerId     Int?         @map("alquiler_id")
  tipoMovimiento MovementType @map("tipo_movimiento")

  cantidad            Int // Unidades enteras
  saldoAnterior       Int      @map("saldo_anterior")
  saldoNuevo          Int      @map("saldo_nuevo")
  referenciaDocumento String?  @map("referencia_documento") @db.VarChar(100)
  observaciones       String?
  usuarioId           String?  @map("usuario_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant    Tenant          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  equipment Equipment       @relation(fields: [equipoId], references: [id], onDelete: Restrict)
  rental    RentalContract? @relation(fields: [alquilerId], references: [id], onDelete: SetNull)

  @@index([empresaId])
  @@index([equipoId])
  @@index([createdAt])
  @@map("kardex_inventario")
}

// ----------------------------------------------------------------------------
// 8. SEGURIDAD & AUDITORÍA FORENSE INMUTABLE
// ----------------------------------------------------------------------------

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  empresaId     String   @map("empresa_id") @db.Uuid
  usuarioId     String?  @map("usuario_id") @db.Uuid
  usuarioNombre String   @default("Sistema") @map("usuario_nombre") @db.VarChar(255)
  usuarioEmail  String   @default("sistema@ferreon.com") @map("usuario_email") @db.VarChar(255)
  usuarioRol    String   @default("SISTEMA") @map("usuario_rol") @db.VarChar(50)
  modulo        String   @db.VarChar(50)
  accion        String   @db.VarChar(100)
  entidadId     String?  @map("entidad_id") @db.VarChar(100)
  descripcion   String
  detalles      Json?    @default("{}")
  ipAddress     String?  @default("127.0.0.1") @map("ip_address") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId, createdAt(sort: Desc)])
  @@index([modulo, accion])
  @@index([usuarioId])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 9. PUNTO DE VENTA (POS) & CONTROL DE CAJA EN EFECTIVO
// ----------------------------------------------------------------------------

model CashSession {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  empresaId       String    @map("empresa_id") @db.Uuid
  usuarioId       String    @map("usuario_id") @db.Uuid
  estado          String    @default("ABIERTA") @db.VarChar(20)
  montoApertura   Decimal   @default(0) @map("monto_apertura") @db.Decimal(15, 2)
  montoCierre     Decimal?  @map("monto_cierre") @db.Decimal(15, 2)
  montoEsperado   Decimal?  @map("monto_esperado") @db.Decimal(15, 2)
  diferencia      Decimal?  @db.Decimal(15, 2)
  motivoDescuadre String?   @map("motivo_descuadre")
  arqueoDetalle   Json?     @map("arqueo_detalle")
  observaciones   String?
  fechaApertura   DateTime? @default(now()) @map("fecha_apertura") @db.Timestamptz(6)
  fechaCierre     DateTime? @map("fecha_cierre") @db.Timestamptz(6)

  tenant      Tenant         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movements   CashMovement[]

  @@index([empresaId])
  @@index([tenantId])
  @@index([estado])
  @@index([usuarioId])
  @@map("sesiones_caja")
}

model CashMovement {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  empresaId     String    @map("empresa_id") @db.Uuid
  sesionCajaId  String    @map("sesion_caja_id") @db.Uuid
  usuarioId     String    @map("usuario_id") @db.Uuid
  tipo          String    @db.VarChar(20)
  monto         Decimal   @db.Decimal(15, 2)
  concepto      String    @db.VarChar(255)
  beneficiario  String?   @db.VarChar(255)
  comprobante   String?   @db.VarChar(100)
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant        Tenant      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cashSession   CashSession @relation(fields: [sesionCajaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([tenantId])
  @@index([sesionCajaId])
  @@map("movimientos_caja")
}

// ----------------------------------------------------------------------------
// 8. LOGÍSTICA DE TRANSPORTE Y RUTAS BUCARAMANGA (SPEC-018)
// ----------------------------------------------------------------------------

model ZonaFleteBucaramanga {
  id                    String        @id @default(uuid()) @db.Uuid
  empresaId             String        @map("empresa_id") @db.Uuid
  codigo                String        @db.VarChar(50)
  nombre                String        @db.VarChar(150)
  municipio             String        @db.VarChar(50)
  tarifaBaseMotocarro   Decimal       @default(20000) @map("tarifa_base_motocarro") @db.Decimal(12, 2)
  tarifaBaseCamioneta   Decimal       @default(45000) @map("tarifa_base_camioneta") @db.Decimal(12, 2)
  tarifaBaseTurbo       Decimal       @default(90000) @map("tarifa_base_turbo") @db.Decimal(12, 2)
  tiempoEstimadoMinutos Int           @default(45) @map("tiempo_estimado_minutos")
  activo                Boolean       @default(true)
  creadoEn              DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)

  tenant                Tenant        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  paradas               RutaParada[]

  @@unique([empresaId, codigo])
  @@index([empresaId, municipio])
  @@map("zonas_flete_bucaramanga")
}

model RutaDespacho {
  id                  String        @id @default(uuid()) @db.Uuid
  empresaId           String        @map("empresa_id") @db.Uuid
  codigoRuta          String        @map("codigo_ruta") @db.VarChar(50)
  fechaProgramada     DateTime      @default(now()) @map("fecha_programada") @db.Date
  vehiculoPlaca       String        @map("vehiculo_placa") @db.VarChar(20)
  vehiculoTipo        String        @default("CAMIONETA") @map("vehiculo_tipo") @db.VarChar(50)
  conductorNombre     String        @map("conductor_nombre") @db.VarChar(100)
  conductorTelefono   String?       @map("conductor_telefono") @db.VarChar(50)
  estado              String        @default("PROGRAMADA") @db.VarChar(30)
  kilometrosEstimados Int?          @default(0) @map("kilometros_estimados")
  totalFletes         Decimal       @default(0) @map("total_fletes") @db.Decimal(14, 2)
  observaciones       String?       @db.Text
  creadoEn            DateTime      @default(now()) @map("creado_en") @db.Timestamptz(6)
  actualizadoEn       DateTime      @default(now()) @updatedAt @map("actualizado_en") @db.Timestamptz(6)

  tenant              Tenant        @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  paradas             RutaParada[]

  @@unique([empresaId, codigoRuta])
  @@index([empresaId, fechaProgramada])
  @@map("rutas_despacho")
}

model RutaParada {
  id                  String               @id @default(uuid()) @db.Uuid
  empresaId           String               @map("empresa_id") @db.Uuid
  rutaId              String               @map("ruta_id") @db.Uuid
  alquilerId          BigInt?              @map("alquiler_id")
  clienteId           BigInt?              @map("cliente_id")
  tipoParada          String               @default("ENTREGA_DESPACHO") @map("tipo_parada") @db.VarChar(30)
  ordenSecuencia      Int                  @default(1) @map("orden_secuencia")
  direccionObra       String               @map("direccion_obra") @db.Text
  zonaId              String?              @map("zona_id") @db.Uuid
  estadoParada        String               @default("PENDIENTE") @map("estado_parada") @db.VarChar(30)
  horaLlegadaEstimada DateTime?            @map("hora_llegada_estimada") @db.Time(6)
  horaCompletada      DateTime?            @map("hora_completada") @db.Timestamptz(6)
  receptorNombre      String?              @map("receptor_nombre") @db.VarChar(100)
  receptorTelefono    String?              @map("receptor_telefono") @db.VarChar(50)
  observaciones       String?              @db.Text
  evidenciaFotos      String[]             @default([]) @map("evidencia_fotos")
  latitud             Decimal?             @db.Decimal(10, 8)
  longitud            Decimal?             @db.Decimal(11, 8)
  creadoEn            DateTime             @default(now()) @map("creado_en") @db.Timestamptz(6)

  tenant              Tenant               @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ruta                RutaDespacho         @relation(fields: [rutaId], references: [id], onDelete: Cascade)
  zona                ZonaFleteBucaramanga? @relation(fields: [zonaId], references: [id], onDelete: SetNull)

  @@index([rutaId, ordenSecuencia])
  @@index([alquilerId])
  @@map("ruta_paradas")
}


