{
  "name": "alquileres-system",
  "version": "1.0.0",
  "private": true,
  "description": "Alquileres System - Sistema Integral de Gestión de Alquileres, Facturación y Equipos de Maquinaria y Construcción (Next.js + Supabase + Vercel)",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:format": "prisma format",
    "supabase:gen-types": "supabase gen types typescript --local > src/infrastructure/persistence/supabase/database.types.ts",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@prisma/client": "^7.10.0",
    "@react-pdf/renderer": "^3.4.5",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.4.1",
    "@supabase/supabase-js": "^2.112.4",
    "@upstash/redis": "^1.34.0",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.428.0",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.85.0",
    "recharts": "^3.10.1",
    "stripe": "^16.8.0",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.46.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "happy-dom": "^20.14.5",
    "postcss": "^8.4.41",
    "prisma": "7.10.0",
    "react-doctor": "^0.9.14",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "lavamoat": {
    "allowScripts": {
      "esbuild": true,
      "unrs-resolver": true,
      "@swc/core": true
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "unrs-resolver@1.12.2": true
  }
}
