# ==============================================================================
# Alquileres System — Plantilla Base de Desarrollo Local (.env.development.local)
# NO colocar credenciales reales en este archivo. Copiar a .env.development.local
# ==============================================================================

# Entorno y Gobernanza de Dominio / Indexación
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
CANONICAL_APP_HOST=
ALLOW_INDEXING=false
LEGACY_VERCEL_HOSTS=alquileres-erp-nextjs-ruby.vercel.app

# Configuración Pública de Supabase (Proyecto DEV)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-dev.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar_con_anon_key_dev_placeholder

# Clave de Rol de Servicio de Supabase (SOLO API Serverless / Backend, NUNCA NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=reemplazar_con_service_role_key_dev_placeholder

# Conexión PostgreSQL para Prisma ORM (Supabase)
# Puerto 6543 (PgBouncer Transaction Pooler) obligatorio para runtime serverless
DATABASE_URL="postgresql://postgres.[REF_DEV]:[PASSWORD_DEV]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Puerto 5432 (Session Direct) exclusivo para migraciones y Prisma CLI
DIRECT_URL="postgresql://postgres.[REF_DEV]:[PASSWORD_DEV]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis (Rate Limiting y Caché Multi-Tenant)
UPSTASH_REDIS_REST_URL=https://tu-endpoint-dev.upstash.io
UPSTASH_REDIS_REST_TOKEN=reemplazar_con_token_redis_dev_placeholder

# Stripe (Modo Test en Desarrollo; opcional)
STRIPE_SECRET_KEY=sk_test_reemplazar_en_local
STRIPE_WEBHOOK_SECRET=whsec_reemplazar_en_local
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_test_mensual_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ID_LIFETIME=price_test_vitalicio_placeholder

# Token Secreto para Endpoints de Cron (opcional si no hay cron jobs activos)
CRON_SECRET=reemplazar_con_secreto_cron_dev
