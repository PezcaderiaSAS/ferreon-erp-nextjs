# ==============================================================================
# Alquileres System — Plantilla de Entorno PRODUCCIÓN (Vercel Scope: Production)
# Configurar estas variables EXCLUSIVAMENTE en Vercel -> Scope: Production.
# NUNCA usar "All Environments" ni commitear valores reales.
# ==============================================================================

# Entorno y Gobernanza de Dominio a Costo $0 / Indexación
NODE_ENV=production
# En Vercel, VERCEL_ENV=production es inyectado automáticamente por la plataforma
VERCEL_ENV=production
NEXT_PUBLIC_APP_URL=https://tu-dominio-canonico-costo-cero.dpdns.org
# Solo hostname sin protocolo ni barra final (ej. tu-dominio.dpdns.org)
CANONICAL_APP_HOST=tu-dominio-canonico-costo-cero.dpdns.org
# Cambiar a 'true' SOLO tras verificar dominio canónico, redirección 301 y Search Console
ALLOW_INDEXING=false
LEGACY_VERCEL_HOSTS=alquileres-erp-nextjs-ruby.vercel.app

# Supabase Producción (Proyecto PROD — Llaves rotadas tras remediación OPS-001)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto-produccion.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=reemplazar_con_anon_key_produccion_rotada
SUPABASE_SERVICE_ROLE_KEY=reemplazar_con_service_role_key_produccion_rotada

# Conexión PostgreSQL Producción (Supabase)
# Puerto 6543 (PgBouncer Transaction Pooler) para Server Actions / Serverless
DATABASE_URL="postgresql://postgres.[REF_PROD]:[PASSWORD_PROD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# Puerto 5432 (Session Direct) exclusivo para migraciones / Prisma CLI
DIRECT_URL="postgresql://postgres.[REF_PROD]:[PASSWORD_PROD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Upstash Redis Producción (Instancia dedicada, separada de Preview)
UPSTASH_REDIS_REST_URL=https://tu-endpoint-prod.upstash.io
UPSTASH_REDIS_REST_TOKEN=reemplazar_con_token_redis_prod_placeholder

# Stripe Live (Producción)
STRIPE_SECRET_KEY=sk_live_reemplazar_en_vercel_production
STRIPE_WEBHOOK_SECRET=whsec_reemplazar_en_vercel_production
NEXT_PUBLIC_STRIPE_PRICE_ID_MONTHLY=price_live_mensual_placeholder
NEXT_PUBLIC_STRIPE_PRICE_ID_LIFETIME=price_live_vitalicio_placeholder

# Token Secreto de Cron (opcional)
CRON_SECRET=reemplazar_con_secreto_cron_produccion_64_hex
